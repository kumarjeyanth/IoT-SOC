# ---------------------------------------------------------------
# SOURCE: files.rules  (24 unique rule(s))
# ---------------------------------------------------------------
alert http any any -> any any (msg:"FILEEXT JPG file claimed"; fileext:"jpg"; sid:300226; rev:1;)
alert http any any -> any any (msg:"FILEEXT BMP file claimed"; fileext:"bmp"; sid:300227; rev:1;)
alert http any any -> any any (msg:"FILESTORE jpg"; flow:established,to_server; fileext:"jpg"; filestore; sid:300228; rev:1;)
alert http any any -> any any (msg:"FILESTORE pdf"; flow:established,to_server; fileext:"pdf"; filestore; sid:300229; rev:1;)
alert http any any -> any any (msg:"FILEMAGIC pdf"; flow:established,to_server; filemagic:"PDF document"; filestore; sid:300230; rev:1;)
alert http any any -> any any (msg:"FILEMAGIC jpg(1)"; flow:established,to_server; filemagic:"JPEG image data"; filestore; sid:300231; rev:1;)
alert http any any -> any any (msg:"FILEMAGIC jpg(2)"; flow:established,to_server; filemagic:"JFIF"; filestore; sid:300232; rev:1;)
alert http any any -> any any (msg:"FILEMAGIC short"; flow:established,to_server; filemagic:"very short file (no magic)"; filestore; sid:300233; rev:1;)
alert http any any -> any any (msg:"FILE store all"; filestore; noalert; sid:300234; rev:1;)
alert http any any -> any any (msg:"FILE magic"; filemagic:"JFIF"; filestore; noalert; sid:300235; rev:1;)
alert http any any -> any any (msg:"FILE magic"; filemagic:"GIF"; filestore; noalert; sid:300236; rev:1;)
alert http any any -> any any (msg:"FILE magic"; filemagic:"PNG"; filestore; noalert; sid:300237; rev:1;)
alert http any any -> any any (msg:"FILE magic -- windows"; flow:established,to_client; filemagic:"executable for MS Windows"; filestore; sid:300238; rev:1;)
alert http any any -> any any (msg:"FILE tracking PNG (1x1 pixel) (1)"; filemagic:"PNG image data, 1 x 1,"; sid:300239; rev:1;)
alert http any any -> any any (msg:"FILE tracking PNG (1x1 pixel) (2)"; filemagic:"PNG image data, 1 x 1|00|"; sid:300240; rev:1;)
alert http any any -> any any (msg:"FILE tracking GIF (1x1 pixel)"; filemagic:"GIF image data, version 89a, 1 x 1|00|"; sid:300241; rev:1;)
alert http any any -> any any (msg:"FILE pdf claimed, but not pdf"; flow:established,to_client; fileext:"pdf"; filemagic:!"PDF document"; filestore; sid:300242; rev:1;)
alert smtp any any -> any any (msg:"File Found over SMTP and stored"; filestore; sid:300243; rev:1;)
alert http any any -> any any (msg:"Black list checksum match and extract MD5"; filemd5:fileextraction-chksum.list; filestore; sid:300244; rev:1;)
alert http any any -> any any (msg:"Black list checksum match and extract SHA1"; filesha1:fileextraction-chksum.list; filestore; sid:300245; rev:1;)
alert http any any -> any any (msg:"Black list checksum match and extract SHA256"; filesha256:fileextraction-chksum.list; filestore; sid:300246; rev:1;)
alert ftp-data any any -> any any (msg:"File Found within FTP and stored"; filestore; filename:"password"; ftpdata_command:stor; sid:300247; rev:1;)
alert smb any any -> any any (msg:"File Found over SMB and stored"; filestore; sid:300248; rev:1;)
alert nfs any any -> any any (msg:"File found within NFS and stored"; filestore; sid:300249; rev:1;)
