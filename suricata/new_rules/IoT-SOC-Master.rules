# ---------------------------------------------------------------
# SOURCE: local.rules  (5 unique rule(s))
# ---------------------------------------------------------------
alert icmp any any -> any any (msg:"LOCAL TEST: Ping Detected"; sid:300000; rev:1;)
alert icmp any any -> any any (msg:"TEST: ICMP Ping Detected"; classtype:not-suspicious; sid:300001; rev:1;)
alert http any any -> any any (msg:"TEST: HTTP GET Request Observed"; http.method; content:"GET"; classtype:not-suspicious; sid:300002; rev:1;)
alert dns any any -> any any (msg:"TEST: DNS Query for test.local"; dns.query; content:"test.local"; nocase; classtype:not-suspicious; sid:300003; rev:1;)
alert tcp any any -> any any (msg:"TEST: EICAR Test File Detected"; content:"X5O!P%@AP[4\\PZX54(P^)7CC)7}$EICAR-STANDARD-ANTIVIRUS-TEST-FILE!$H+H*"; classtype:bad-unknown; sid:300004; rev:1;)

# ---------------------------------------------------------------
# SOURCE: mqtt-even.rules  (11 unique rule(s))
# ---------------------------------------------------------------
alert mqtt any any -> any any (msg:"SURICATA MQTT CONNECT not seen before CONNACK"; app-layer-event:mqtt.missing_connect; classtype:protocol-command-decode; sid:300005; rev:1;)
alert mqtt any any -> any any (msg:"SURICATA MQTT PUBLISH not seen before PUBACK/PUBREL/PUBREC/PUBCOMP"; app-layer-event:mqtt.missing_publish; classtype:protocol-command-decode; sid:300006; rev:1;)
alert mqtt any any -> any any (msg:"SURICATA MQTT SUBSCRIBE not seen before SUBACK"; app-layer-event:mqtt.missing_subscribe; classtype:protocol-command-decode; sid:300007; rev:1;)
alert mqtt any any -> any any (msg:"SURICATA MQTT UNSUBSCRIBE not seen before UNSUBACK"; app-layer-event:mqtt.missing_unsubscribe; classtype:protocol-command-decode; sid:300008; rev:1;)
alert mqtt any any -> any any (msg:"SURICATA MQTT duplicate CONNECT"; app-layer-event:mqtt.double_connect; classtype:protocol-command-decode; sid:300009; rev:1;)
alert mqtt any any -> any any (msg:"SURICATA MQTT message seen before CONNECT/CONNACK completion"; app-layer-event:mqtt.unintroduced_message; classtype:protocol-command-decode; sid:300010; rev:1;)
alert mqtt any any -> any any (msg:"SURICATA MQTT invalid QOS level"; app-layer-event:mqtt.invalid_qos_level; classtype:protocol-command-decode; sid:300011; rev:1;)
alert mqtt any any -> any any (msg:"SURICATA MQTT missing message ID"; app-layer-event:mqtt.missing_msg_id; classtype:protocol-command-decode; sid:300012; rev:1;)
alert mqtt any any -> any any (msg:"SURICATA MQTT unassigned message type (0 or >15)"; app-layer-event:mqtt.unassigned_msg_type; classtype:protocol-command-decode; sid:300013; rev:1;)
alert mqtt any any -> any any (msg:"SURICATA MQTT too many transactions"; app-layer-event:mqtt.too_many_transactions; classtype:protocol-command-decode; sid:300014; rev:1;)
alert mqtt any any -> any any (msg:"SURICATA MQTT malformed traffic"; app-layer-event:mqtt.malformed_traffic; classtype:protocol-command-decode; sid:300015; rev:1;)

# ---------------------------------------------------------------
# SOURCE: mqtt-IoT-Anomaly.rules  (8 unique rule(s))
# ---------------------------------------------------------------
alert tcp $IOT_NET any -> $HOME_NET [22,23,80,443] (msg:"IoT: Unauthorized Lateral Movement Attempt"; flow:to_server,established; classtype:network-scan; sid:300016; rev:1;)
alert mqtt any any -> any 1883 (msg:"IoT: MQTT Connection Refused (Potential Brute Force/Misconfig)"; mqtt.reason_code:0x05; threshold:type threshold, track by_src, count 5, seconds 60; classtype:bad-unknown; sid:300017; rev:1;)
alert tcp $EXTERNAL_NET any -> $IOT_NET 23 (msg:"IoT: Mirai Botnet Telnet Login Attempt"; flow:to_server,established; content:"root"; nocase; content:"admin"; nocase; distance:1; threshold:type threshold, track by_src, count 3, seconds 10; classtype:bad-unknown; sid:300018; rev:1;)
alert dns $IOT_NET any -> any any (msg:"IoT: Device Queried Dynamic DNS Domain (Possible C2)"; dns.query; content:"duckdns.org"; nocase; classtype:trojan-activity; sid:300019; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"ET IoT Mirai Botnet CNC Check-in"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/login.php"; http.request_body; content:"username="; content:"password="; reference:url,github.com/decanio/suricata-IoT; classtype:trojan-activity; sid:300020; rev:1;)
alert tcp $HOME_NET any -> any 1883 (msg:"LOCAL IoT Plaintext MQTT Critical Command Detected"; flow:established,to_server; content:"|10|"; depth:1; content:"unencrypted_topic"; content:"action=unlock"; fast_pattern; classtype:policy-violation; sid:300021; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 23 (msg:"LOCAL IoT Internal Telnet Brute Force Attempt"; flow:to_server,established; content:"root"; nocase; content:"admin"; nocase; distance:0; threshold:type threshold, track by_src, count 10, seconds 60; classtype:suspicious-login; sid:300022; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL IoT Rogue Firmware .bin Download Attempt"; flow:established,to_server; http.uri; content:".bin"; endswith; classtype:bad-unknown; sid:300023; rev:1;)

# ---------------------------------------------------------------
# SOURCE: IoT-JSON-App.rules  (6 unique rule(s))
# ---------------------------------------------------------------
alert tcp any any -> any 1883 (msg:"IoT SOC: Critical Environmental CO2 Spike Detected"; flow:established,to_server; content:"\"co2\":"; pcre:"/\"co2\":\s*[2-5]\d{3}/"; classtype:bad-unknown; sid:300024; rev:1;)
alert tcp any any -> any 1883 (msg:"IoT SOC: Device Tamper Alarm Triggered"; flow:established,to_server; content:"\"tamper_alarm\": true"; classtype:bad-unknown; sid:300025; rev:1;)
alert tcp any any -> any 1883 (msg:"IoT SOC: Malicious Firmware Variant Detected"; flow:established,to_server; content:"9.9.9_MALWARE_MOD"; nocase; classtype:trojan-activity; sid:300026; rev:1;)
alert tcp any any -> any 1883 (msg:"IoT SOC: Hardware Failure Exception - Frozen Sensor Error Detected"; flow:established,to_server; content:"\"temperature\": -99"; classtype:bad-unknown; sid:300027; rev:1;)
alert tcp !192.168.1.0/24 any -> any 1883 (msg:"IoT SOC: Unauthorized External Connection to MQTT Broker"; flow:to_server; classtype:policy-violation; sid:300028; rev:1;)
alert tcp any any -> any 1883 (msg:"IoT SOC: Potential MQTT Brute Force/Flood Attempt"; flow:to_server; flags:S; threshold:type threshold, track by_src, count 30, seconds 10; sid:300029; rev:1;)

# ---------------------------------------------------------------
# SOURCE: mqtt-common.rules  (14 unique rule(s))
# ---------------------------------------------------------------
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"IoT DDOS - Outbound SYN Flood Traffic"; flags:S; threshold:type threshold, track by_src, count 100, seconds 10; classtype:attempted-dos; sid:300030; rev:1;)
alert udp $HOME_NET any -> $EXTERNAL_NET any (msg:"IoT DDOS - Outbound UDP Flood Traffic"; threshold:type threshold, track by_src, count 500, seconds 5; classtype:attempted-dos; sid:300031; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"IoT BRUTEFORCE - Inbound SSH Auth Failure"; flow:to_client,established; content:"Permission denied"; nocase; threshold:type threshold, track by_dst, count 5, seconds 30; classtype:unauthorized-access; sid:300032; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 23 (msg:"IoT BRUTEFORCE - Inbound Telnet Auth Failure"; flow:to_client,established; content:"Login incorrect"; nocase; threshold:type threshold, track by_dst, count 5, seconds 30; classtype:unauthorized-access; sid:300033; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 80 (msg:"IoT BRUTEFORCE - HTTP Web Interface Auth Failure"; flow:to_client,established; content:"401 Unauthorized"; nocase; threshold:type threshold, track by_dst, count 10, seconds 60; classtype:unauthorized-access; sid:300034; rev:1;)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"IoT PING - Inbound ICMP Echo Request"; itype:8; icode:0; classtype:network-scan; sid:300035; rev:1;)
alert icmp $HOME_NET any -> $EXTERNAL_NET any (msg:"IoT PING - Outbound ICMP Echo Request"; itype:8; icode:0; classtype:bad-unknown; sid:300036; rev:1;)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"IoT PING - Large Packet Size Potential DoS"; dsize:>1000; itype:8; classtype:attempted-dos; sid:300037; rev:1;)
alert ip $EXTERNAL_NET any -> $HOME_NET any (msg:"IoT TRAFFIC - Unauthorized External Inbound Connection"; flow:to_server; flags:S; classtype:policy-violation; sid:300038; rev:1;)
alert ip $HOME_NET any -> $EXTERNAL_NET any (msg:"IoT TRAFFIC - Unauthorized Outbound Connection to Internet"; flow:to_server; flags:S; classtype:policy-violation; sid:300039; rev:1;)
alert ip $HOME_NET any -> $HOME_NET any (msg:"IoT TRAFFIC - Internal Lateral Movement Target Discovery"; flow:to_server; flags:S; classtype:suspicious-activity; sid:300040; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 1883 (msg:"IoT MQTT - Unauthorized Publish To Restricted Admin Topic"; flow:to_server,established; content:"|30|"; depth:1; content:"admin/system/command"; nocase; classtype:policy-violation; sid:300041; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 1883 (msg:"IoT MQTT - Unknown or Unregistered Application Topic Publish"; flow:to_server,established; content:"|30|"; depth:1; content:"/firmware/update"; nocase; classtype:suspicious-activity; sid:300042; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 1883 (msg:"IoT MQTT - Base Topic Level Anomaly Wildcard Publish"; flow:to_server,established; content:"|30|"; depth:1; content:"#"; classtype:protocol-command-decode; sid:300043; rev:1;)		

