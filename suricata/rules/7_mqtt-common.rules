alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"IoT DDOS - Outbound SYN Flood Traffic"; flags:S; threshold:type threshold, track by_src, count 100, seconds 10; classtype:attempted-dos; sid:3000001; rev:1;)
alert udp $HOME_NET any -> $EXTERNAL_NET any (msg:"IoT DDOS - Outbound UDP Flood Traffic"; threshold:type threshold, track by_src, count 500, seconds 5; classtype:attempted-dos; sid:3000002; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"IoT BRUTEFORCE - Inbound SSH Auth Failure"; flow:to_client,established; content:"Permission denied"; nocase; threshold:type threshold, track by_dst, count 5, seconds 30; classtype:unauthorized-access; sid:3000003; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 23 (msg:"IoT BRUTEFORCE - Inbound Telnet Auth Failure"; flow:to_client,established; content:"Login incorrect"; nocase; threshold:type threshold, track by_dst, count 5, seconds 30; classtype:unauthorized-access; sid:3000004; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 80 (msg:"IoT BRUTEFORCE - HTTP Web Interface Auth Failure"; flow:to_client,established; content:"401 Unauthorized"; nocase; threshold:type threshold, track by_dst, count 10, seconds 60; classtype:unauthorized-access; sid:3000005; rev:1;)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"IoT PING - Inbound ICMP Echo Request"; itype:8; icode:0; classtype:network-scan; sid:3000006; rev:1;)
alert icmp $HOME_NET any -> $EXTERNAL_NET any (msg:"IoT PING - Outbound ICMP Echo Request"; itype:8; icode:0; classtype:bad-unknown; sid:3000007; rev:1;)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"IoT PING - Large Packet Size Potential DoS"; dsize:>1000; itype:8; classtype:attempted-dos; sid:3000008; rev:1;)
alert ip $EXTERNAL_NET any -> $HOME_NET any (msg:"IoT TRAFFIC - Unauthorized External Inbound Connection"; flow:to_server; flags:S; classtype:policy-violation; sid:3000009; rev:1;)
alert ip $HOME_NET any -> $EXTERNAL_NET any (msg:"IoT TRAFFIC - Unauthorized Outbound Connection to Internet"; flow:to_server; flags:S; classtype:policy-violation; sid:3000010; rev:1;)
alert ip $HOME_NET any -> $HOME_NET any (msg:"IoT TRAFFIC - Internal Lateral Movement Target Discovery"; flow:to_server; flags:S; classtype:suspicious-activity; sid:3000011; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 1883 (msg:"IoT MQTT - Unauthorized Publish To Restricted Admin Topic"; flow:to_server,established; content:"|30|"; depth:1; content:"admin/system/command"; nocase; classtype:policy-violation; sid:3000012; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 1883 (msg:"IoT MQTT - Unknown or Unregistered Application Topic Publish"; flow:to_server,established; content:"|30|"; depth:1; content:"/firmware/update"; nocase; classtype:suspicious-activity; sid:3000013; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 1883 (msg:"IoT MQTT - Base Topic Level Anomaly Wildcard Publish"; flow:to_server,established; content:"|30|"; depth:1; content:"#"; classtype:protocol-command-decode; sid:3000014; rev:1;)


#============================mqtt-common.rules END======================
